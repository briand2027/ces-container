APP_NAME="C.E.S. Container"
APP_ENV=production
APP_KEY=base64:GENERATE_A_UNIQUE_KEY_ON_THE_SERVER
APP_DEBUG=false
APP_URL=https://containerequipmentservices.lt

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HOSTING_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_HOSTING_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_NEW_DATABASE_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_MAILBOX_USERNAME
MAIL_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
MAIL_FROM_ADDRESS=REPLACE_WITH_MAILBOX_ADDRESS
MAIL_FROM_NAME="${APP_NAME}"
